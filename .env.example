# 复制为 .env（勿提交）。Spring Boot 通过 spring.config.import 加载；
# Docker Compose 另会用本文件做 compose.yaml 变量替换。

# --- 使用 compose.yaml 本地启动（可选）---
POSTGRES_PASSWORD=

# --- 不使用 Compose、自备 PostgreSQL 时（须关闭 Boot 自动 compose）---
SPRING_DOCKER_COMPOSE_ENABLED=false
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/roseiot
SPRING_DATASOURCE_USERNAME=roseiot
SPRING_DATASOURCE_PASSWORD=
# SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=10

# SERVER_PORT=8080

# --- Web API JWT 签名（必填：HS256，至少 32 字节；生产使用独立随机密钥）---
ROSEIOT_AUTH_JWT_SECRET=
# JWT issuer 和 audience 默认值见 application.yml；多环境部署应按环境配置 issuer。
# ROSEIOT_AUTH_JWT_ISSUER=https://roseiot.local
# ROSEIOT_AUTH_JWT_AUDIENCE=roseiot-api

# --- 密码重置邮件（配置 SMTP 后启用）---
ROSEIOT_PASSWORD_RESET_EMAIL_ENABLED=false
ROSEIOT_PASSWORD_RESET_EMAIL_FROM=roseiot@localhost
ROSEIOT_MAIL_HOST=localhost
ROSEIOT_MAIL_PORT=1025
ROSEIOT_MAIL_USERNAME=
ROSEIOT_MAIL_PASSWORD=
ROSEIOT_MAIL_SMTP_AUTH=false
ROSEIOT_MAIL_SMTP_STARTTLS=false

# --- 登录/恢复限速（可选；默认见 application.yml）---
# ROSEIOT_RATE_LIMIT_ENABLED=true
