# 复制为 .env（勿提交）。Spring Boot 通过 spring.config.import 加载；
# Docker Compose 另会用本文件做 compose.yaml 变量替换。

# --- 使用 compose.yaml 本地启动（可选）---
POSTGRES_PASSWORD=

# --- 不使用 Compose、自备 PostgreSQL 时（须关闭 Boot 自动 compose）---
SPRING_DOCKER_COMPOSE_ENABLED=false
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/roseiot
SPRING_DATASOURCE_USERNAME=roseiot
SPRING_DATASOURCE_PASSWORD=

# SERVER_PORT=8080
