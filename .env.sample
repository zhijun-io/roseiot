# Copy to .env for local development. Do not store real credentials here.
SERVER_PORT=8080
POSTGRES_PORT=5432
POSTGRES_DB=roseiot
POSTGRES_USER=roseiot
POSTGRES_PASSWORD=change-me-local-only
# Generate a unique value with: openssl rand -base64 32
ROSEIOT_JWT_HMAC_SECRET=replace-with-a-unique-base64-encoded-32-byte-key
ROSEIOT_ACCESS_TOKEN_TTL=10m
ROSEIOT_REFRESH_TOKEN_TTL=30d
ROSEIOT_PASSWORD_RESET_TOKEN_TTL=30m
ROSEIOT_PASSWORD_MINIMUM_LENGTH=12
APP_BASE_URL=http://localhost:8080
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@localhost
